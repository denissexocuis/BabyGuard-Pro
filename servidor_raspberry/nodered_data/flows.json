        "id": "d5f9ef1e749d4752",
        "type": "function",
        "z": "cdfa6a64c8bdf5d5",
        "name": "status temp",
        "func": "let temp = msg.payload;\n\nif (temp < 20) {\n    msg.payload = {\n        \"chatId\": env.get(\"TELEGRAM_CHAT_ID\"),\n        \"type\": \"message\",\n        \"content\": `🔵 Temperatura baja en la cuna: ${temp}°C. El bebé puede tener frío.`\n    };\n    return msg;\n} else if (temp > 30) {\n    msg.payload = {\n        \"chatId\": env.get(\"TELEGRAM_CHAT_ID\"),\n        \"type\": \"message\",\n        \"content\": temp > 35\n            ? `🔴 ALERTA: Temperatura muy alta: ${temp}°C. ¡Revisa al bebé!`\n            : `🟡 Temperatura elevada en la cuna: ${temp}°C. Ventila el cuarto.`\n    };\n    return msg;\n}\nreturn null; // entre 20-30 todo bien",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 790,
        "y": 320,
