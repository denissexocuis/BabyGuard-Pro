        "type": "function",
        "z": "cdfa6a64c8bdf5d5",
        "name": "status hum",
        "func": "let hum = msg.payload;\n\nif (hum < 40) {\n    msg.payload = {\n        \"chatId\": env.get(\"TELEGRAM_CHAT_ID\"),\n        \"type\": \"message\",\n        \"content\": `🟡 Humedad baja: ${hum}%. El ambiente está muy seco para el bebé.`\n    };\n    return msg;\n} else if (hum > 70) {\n    msg.payload = {\n        \"chatId\": env.get(\"TELEGRAM_CHAT_ID\"),\n        \"type\": \"message\",\n        \"content\": `🟡 Humedad alta: ${hum}%. El cuarto está muy húmedo.`\n    };\n    return msg;\n}\nreturn null; // entre 40-70 todo bien",
