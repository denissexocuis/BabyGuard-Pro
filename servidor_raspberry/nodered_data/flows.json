        "func": "// insertar con hora de méxico\nmsg.topic = 'INSERT INTO sensor_logs (temp, humedad, ruido, ts) values (?, ?, ?, CONVERT_TZ(NOW(), \"+00:00\", \"-06:00\"));';\n\n// extraer las variables usando el nuevo objeto parseado\nlet temp = msg.payload.temp;\nlet hum = msg.payload.humedad;\nlet ruido = msg.payload.ruido;\n\n// pasar el arreglo de parámetros limpios al nodo de MySQL\nmsg.payload = [temp, hum, ruido];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
