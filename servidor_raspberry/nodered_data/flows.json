    {
        "id": "58af47133d53f68d",
        "type": "function",
        "z": "cdfa6a64c8bdf5d5",
        "name": "function 1",
        "func": "msg.topic = 'INSERT INTO sensor_logs (temp, humedad, ruido, ts) values (?, ?, ?, NOW());';\n\nlet temp = msg.payload.temp;\nlet hum = msg.payload.humedad;\nlet ruido = msg.payload.ruido;\n\nmsg.payload = [temp, hum, ruido];\n\nreturn msg;",
