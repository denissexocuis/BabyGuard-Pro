    {
        "id": "3981d641017ec50f",
        "type": "function",
        "z": "cdfa6a64c8bdf5d5",
        "name": "Foto Alerta Telegram",
        "func": "// 1. Forzamos a Node-RED a convertir el mensaje en un objeto real\nlet data = msg.payload;\nif (typeof data === 'string') {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {\n        return null; // Si no es un JSON válido, ignora el mensaje\n    }\n}\n\n// 2. Evaluamos de forma segura que contenga la foto de la cámara\nif (data && data.imagen_base64) {\n    var textoAlerta = data.mensaje || \"¡Bebé fuera de la cuna!\";\n    var stringBase64 = data.imagen_base64;\n\n    // 3. Convertimos el Base64 a Buffer binario para Telegram\n    var imagenBinaria = Buffer.from(stringBase64, 'base64');\n\n    // 4. Estructuramos el mensaje final para el Bot\n    msg.payload = {\n        chatId: env.get(\"TELEGRAM_CHAT_ID\"),\n        type: \"photo\",\n        content: imagenBinaria,\n        caption: \"⚠️ ¡ALERTA CRÍTICA! \" + textoAlerta\n    };\n\n    return msg;\n}\n\n// Si el mensaje viene de los sensores de temperatura, lo ignora y no truena\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
